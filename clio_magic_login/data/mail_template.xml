<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_template_magic_link" model="mail.template">
        <field name="name">Clio Magic Login Link</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="subject">Din inloggningslänk</field>
        <field name="email_to">{{ object.email }}</field>
        <field name="body_html"><![CDATA[
<div style="font-family: Arial, sans-serif; max-width: 480px; margin: 0 auto; padding: 24px;">
    <p>Hej {{ object.name }},</p>
    <p>Klicka på knappen nedan för att logga in. Länken är giltig i <strong>15 minuter</strong> och kan bara användas en gång.</p>
    <div style="text-align: center; margin: 32px 0;">
        <a href="{{ ctx['verify_url'] }}"
           style="background-color: #714B67; color: white; padding: 12px 28px; text-decoration: none; border-radius: 4px; font-size: 16px;">
            Logga in nu
        </a>
    </div>
    <p style="color: #888; font-size: 13px;">
        Om du inte begärde den här länken kan du ignorera det här mailet.
        Länken fungerar inte om du begär en ny.
    </p>
    <p style="color: #888; font-size: 12px;">
        Om knappen inte fungerar, kopiera den här länken till din webbläsare:<br/>
        {{ ctx['verify_url'] }}
    </p>
</div>
        ]]></field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
