<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="login" name="Clio Magic Login">
        <t t-call="web.login_layout">
            <div style="max-width: 420px; margin: 0 auto; padding: 1rem 0;">

                <!-- Magic link sent: confirmation screen -->
                <div t-if="magic_link_sent" class="text-center py-3">
                    <i class="fa fa-envelope-o fa-3x text-muted mb-3 d-block"/>
                    <h5 class="mb-2">Kontrollera din e-post</h5>
                    <p class="text-muted mb-4">
                        Vi har skickat en inloggningslänk till din adress.<br/>
                        Länken är giltig i <strong>15 minuter</strong>.
                    </p>
                    <a href="/web/login" class="btn btn-link btn-sm">Tillbaka till inloggning</a>
                </div>

                <t t-if="not magic_link_sent">

                    <!-- Error / info messages -->
                    <p class="alert alert-danger" t-if="error" role="alert"><t t-esc="error"/></p>
                    <p class="alert alert-success" t-if="message" role="status"><t t-esc="message"/></p>

                    <!-- SECTION 1: Create account -->
                    <t t-if="signup_enabled">
                        <p class="text-center text-muted small fw-semibold mb-3 text-uppercase" style="letter-spacing:.05em;">Skapa konto</p>
                        <form action="/web/signup" method="post" role="form">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="redirect" t-att-value="redirect"/>
                            <div class="mb-2">
                                <input type="text" name="name" class="form-control" placeholder="Namn" required="required" autocomplete="name"/>
                            </div>
                            <div class="mb-2">
                                <input type="text" name="login" class="form-control" placeholder="E-postadress" required="required" autocomplete="username"/>
                            </div>
                            <div class="mb-2">
                                <input type="password" name="password" class="form-control" placeholder="Lösenord" required="required" autocomplete="new-password"/>
                            </div>
                            <div class="mb-3">
                                <input type="password" name="confirm_password" class="form-control" placeholder="Bekräfta lösenord" required="required" autocomplete="new-password"/>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary">Skapa konto</button>
                            </div>
                        </form>

                        <div class="my-4 d-flex align-items-center gap-2">
                            <hr class="flex-grow-1 m-0"/>
                            <span class="text-muted small">eller logga in</span>
                            <hr class="flex-grow-1 m-0"/>
                        </div>
                    </t>

                    <t t-if="not signup_enabled">
                        <p class="text-center text-muted small fw-semibold mb-3 text-uppercase" style="letter-spacing:.05em;">Logga in</p>
                    </t>

                    <!-- SECTION 2: Magic link (primary) -->
                    <form action="/web/login" method="post" role="form" id="o_magic_link_form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="type" value="magic_link"/>
                        <input type="hidden" name="redirect" t-att-value="redirect"/>
                        <div class="mb-3">
                            <input type="text" name="login" class="form-control" t-att-value="login"
                                   placeholder="E-postadress" required="required"
                                   autocomplete="username" autofocus="autofocus"/>
                        </div>
                        <div class="d-grid mb-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-envelope-o me-1"/> Skicka inloggningslänk
                            </button>
                        </div>
                        <div class="text-center">
                            <a href="#" class="btn btn-link btn-sm text-muted" id="o_show_password_login">
                                Logga in med lösenord istället
                            </a>
                        </div>
                    </form>

                    <!-- SECTION 3: Password login (hidden) -->
                    <form action="/web/login" method="post" role="form" id="o_password_form"
                          class="d-none mt-3" onsubmit="this.action = '/web/login' + location.hash">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="type" value="password"/>
                        <input type="hidden" name="redirect" t-att-value="redirect"/>
                        <div class="mb-2">
                            <input type="text" name="login" class="form-control" t-att-value="login"
                                   placeholder="E-postadress" required="required" autocomplete="username"/>
                        </div>
                        <div class="mb-3">
                            <input type="password" name="password" class="form-control"
                                   placeholder="Lösenord" required="required" autocomplete="current-password"/>
                        </div>
                        <div class="d-grid mb-2">
                            <button type="submit" class="btn btn-outline-primary">Logga in</button>
                        </div>
                        <div class="text-center">
                            <a href="#" class="btn btn-link btn-sm text-muted" id="o_hide_password_login">
                                Skicka länk istället
                            </a>
                        </div>
                    </form>

                    <script>
                    (function() {
                        var mf = document.getElementById('o_magic_link_form');
                        var pf = document.getElementById('o_password_form');
                        document.getElementById('o_show_password_login').addEventListener('click', function(e) {
                            e.preventDefault();
                            mf.classList.add('d-none'); pf.classList.remove('d-none');
                            pf.querySelector('input[name=login]').value = mf.querySelector('input[name=login]').value;
                            pf.querySelector('input[type=password]').focus();
                        });
                        document.getElementById('o_hide_password_login').addEventListener('click', function(e) {
                            e.preventDefault();
                            pf.classList.add('d-none'); mf.classList.remove('d-none');
                            mf.querySelector('input[name=login]').value = pf.querySelector('input[name=login]').value;
                            mf.querySelector('input[name=login]').focus();
                        });
                    })();
                    </script>

                </t>
            </div>
        </t>
    </template>
</odoo>
