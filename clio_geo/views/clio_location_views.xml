<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_clio_location_tree" model="ir.ui.view">
        <field name="name">clio.location.tree</field>
        <field name="model">clio.location</field>
        <field name="arch" type="xml">
            <list string="Known Locations">
                <field name="name"/>
                <field name="display_name_geo"/>
                <field name="lat"/>
                <field name="lon"/>
                <field name="radius_m"/>
                <field name="category"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_clio_location_form" model="ir.ui.view">
        <field name="name">clio.location.form</field>
        <field name="model">clio.location</field>
        <field name="arch" type="xml">
            <form string="Known Location">
                <sheet>
                    <group>
                        <group string="Identitet">
                            <field name="name"/>
                            <field name="display_name_geo"/>
                            <field name="category"/>
                            <field name="active"/>
                        </group>
                        <group string="GPS">
                            <field name="lat"/>
                            <field name="lon"/>
                            <field name="radius_m"/>
                        </group>
                    </group>
                    <group string="Adress">
                        <field name="street"/>
                        <field name="street_number"/>
                        <field name="zip"/>
                        <field name="city"/>
                        <field name="state_id"/>
                        <field name="country_id"/>
                    </group>
                    <group string="Anteckningar">
                        <field name="notes" nolabel="1"/>
                    </group>
                    <group string="Karta">
                        <field name="map_url" widget="url" string="Öppna i OSM"/>
                        <field name="map_iframe" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_clio_location" model="ir.actions.act_window">
        <field name="name">Known Locations</field>
        <field name="res_model">clio.location</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_active": 1}</field>
    </record>

</odoo>
