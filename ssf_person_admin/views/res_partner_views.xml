<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_ssf_admin_form" model="ir.ui.view">
        <field name="name">res.partner.ssf.admin</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="SSF Admin" name="ssf_admin"
                      invisible="is_company == True"
                      groups="base.group_system,ssf_crm_access.group_ssf_sf_admin,ssf_crm_access.group_ssf_sdf_admin">
                    <group string="FIS">
                        <field name="fis_code"/>
                    </group>
                    <group string="Chip-koder">
                        <field name="chip_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="chip_no"/>
                                <field name="sector_id"/>
                                <field name="source" readonly="1"/>
                            </list>
                        </field>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
