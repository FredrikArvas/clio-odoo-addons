<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ── Listvy ─────────────────────────────────────────────────────────── -->
  <record id="view_clio_media_article_list" model="ir.ui.view">
    <field name="name">clio.media.article.list</field>
    <field name="model">clio.media.article</field>
    <field name="arch" type="xml">
      <list string="Artiklar"
            decoration-success="is_matched == True"
            default_order="first_seen desc">
        <field name="first_seen"    string="Sedd"/>
        <field name="published"     string="Publicerad" optional="show"/>
        <field name="country"       string="Land"       optional="show"/>
        <field name="source"        string="Källa"/>
        <field name="title"         string="Rubrik"/>
        <field name="author"        string="Journalist (rå)"    optional="show"/>
        <field name="journalist_ids" string="Journalister"         widget="many2many_tags" optional="show"/>
        <field name="relevance_class" string="Klass" widget="badge" optional="show"/>
        <field name="tone"          string="Ton"               widget="badge" optional="show"/>
        <field name="article_type"  string="Typ"               widget="badge" optional="show"/>
        <field name="thematic_frame" string="Inramning"        optional="hide"/>
        <field name="match_score"   string="Score"             optional="hide"/>
        <field name="is_matched"    string="Matchad"           widget="boolean" optional="hide"/>
        <field name="protocol_id"   string="Protokoll"         optional="hide"/>
        <field name="is_false_positive" string="Ej UAP-rel."  optional="show" widget="boolean_toggle"/>
        <field name="media_type"    string="Mediatyp"          widget="badge" optional="hide"/>
      </list>
    </field>
  </record>

  <!-- ── Kanban-vy ──────────────────────────────────────────────────────── -->
  <record id="view_clio_media_article_kanban" model="ir.ui.view">
    <field name="name">clio.media.article.kanban</field>
    <field name="model">clio.media.article</field>
    <field name="arch" type="xml">
      <kanban default_group_by="media_type" default_order="first_seen desc">
        <field name="title"/>
        <field name="source"/>
        <field name="published"/>
        <field name="first_seen"/>
        <field name="relevance_class"/>
        <field name="media_type"/>
        <field name="data_source"/>
        <field name="is_matched"/>
        <field name="url"/>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_global_click">
              <div class="o_kanban_record_top mb-0">
                <div class="o_kanban_record_headings">
                  <strong class="o_kanban_record_title">
                    <field name="title"/>
                  </strong>
                </div>
                <div class="o_kanban_record_body">
                  <span class="text-muted"><field name="source"/></span>
                  <t t-if="record.published.value">
                    <span class="ms-2 text-muted small"><field name="published"/></span>
                  </t>
                </div>
                <div class="o_kanban_record_bottom">
                  <field name="relevance_class" widget="badge"/>
                  <field name="media_type" widget="badge"/>
                </div>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- ── Diagramvy ──────────────────────────────────────────────────────── -->
  <record id="view_clio_media_article_graph" model="ir.ui.view">
    <field name="name">clio.media.article.graph</field>
    <field name="model">clio.media.article</field>
    <field name="arch" type="xml">
      <graph string="Artiklar" type="bar" sample="1">
        <field name="source"          type="row"/>
        <field name="relevance_class" type="col"/>
      </graph>
    </field>
  </record>

  <!-- ── Pivotvy ────────────────────────────────────────────────────────── -->
  <record id="view_clio_media_article_pivot" model="ir.ui.view">
    <field name="name">clio.media.article.pivot</field>
    <field name="model">clio.media.article</field>
    <field name="arch" type="xml">
      <pivot string="Artiklar" sample="1">
        <field name="source"          type="row"/>
        <field name="media_type"      type="col"/>
        <field name="relevance_class" type="col"/>
      </pivot>
    </field>
  </record>

  <!-- ── Formulärvy ─────────────────────────────────────────────────────── -->
  <record id="view_clio_media_article_form" model="ir.ui.view">
    <field name="name">clio.media.article.form</field>
    <field name="model">clio.media.article</field>
    <field name="arch" type="xml">
      <form string="Artikel">
        <sheet>
          <div class="oe_title">
            <h1><field name="title" readonly="1"/></h1>
          </div>
          <group>
            <group string="Metadata">
              <field name="source"      string="Källa"/>
              <field name="country"     string="Land"/>
              <field name="language"    string="Språk"/>
              <field name="author"      string="Journalist (rå)" readonly="1"/>
              <field name="journalist_ids" string="Journalister" widget="many2many_tags"/>
              <field name="media_type"  string="Mediatyp"/>
              <field name="published"   string="Publicerad"/>
              <field name="first_seen"  string="Först sedd" readonly="1"/>
              <field name="url" widget="url" string="URL" readonly="1" colspan="2"/>
            </group>
            <group string="Kodning">
              <field name="relevance_class"      string="Klassificering"/>
              <field name="tone"                 string="Ton"/>
              <field name="article_type"         string="Artikeltyp"/>
              <field name="thematic_frame"       string="Tematisk inramning"/>
              <field name="cited_actors"         string="Citerade aktörer"/>
              <field name="temporal_marker_match" string="Tidsmarkör"/>
            </group>
          </group>
          <group>
            <group string="Analys">
              <field name="match_score"  string="Score"/>
              <field name="is_matched"   string="Matchad"/>
              <field name="data_source"  string="Datakälla"/>
            </group>
            <group string="Körning">
              <field name="protocol_id" string="Protokoll-ID"/>
              <field name="is_false_positive" string="Ej UAP-relevant"/>
              <field name="run_id"      string="Körning"/>
            </group>
          </group>
          <group string="Artikel">
            <field name="body_snippet" string="Utdrag (auto)" readonly="1"/>
          </group>
          <group string="Fulltext">
            <field name="fetch_status" string="Hämtstatus" widget="badge"/>
            <field name="is_personal_use" string="Privat bruk — upphovsrätt gäller"/>
            <field name="body" nolabel="1" placeholder="Klistra in eller hämta artikeltext här..."/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ── Sökvy ──────────────────────────────────────────────────────────── -->
  <record id="view_clio_media_article_search" model="ir.ui.view">
    <field name="name">clio.media.article.search</field>
    <field name="model">clio.media.article</field>
    <field name="arch" type="xml">
      <search string="Sök artiklar">
        <field name="title"/>
        <field name="source"/>
        <field name="author"/>
        <field name="journalist_ids"/>
        <field name="protocol_id"/>
        <field name="run_id"/>
        <separator/>
        <filter name="matched"              string="Matchade"           domain="[('is_matched','=',True)]"/>
        <filter name="unmatched"            string="Omatchade"          domain="[('is_matched','=',False)]"/>
        <separator/>
        <filter name="tone_neutral"         string="Neutral"            domain="[('tone','=','neutral_faktabaserad')]"/>
        <filter name="tone_skeptisk"        string="Skeptisk"           domain="[('tone','=','skeptisk')]"/>
        <filter name="tone_sensationalist"  string="Sensationalistisk"  domain="[('tone','=','sensationalistisk')]"/>
        <separator/>
        <filter name="reaktiv"              string="Reaktiva"           domain="[('article_type','=','reaktiv')]"/>
        <filter name="proaktiv"             string="Proaktiva"          domain="[('article_type','=','proaktiv')]"/>
        <separator/>
        <filter name="country_se"           string="Sverige"            domain="[('country','=','SE')]"/>
        <filter name="country_us"           string="USA"                domain="[('country','=','US')]"/>
        <filter name="country_fr"           string="Frankrike"          domain="[('country','=','FR')]"/>
        <filter name="country_br"           string="Brasilien"          domain="[('country','=','BR')]"/>
        <separator/>
        <filter name="false_positive"       string="Ej UAP-relevant"   domain="[('is_false_positive','=',True)]"/>
        <filter name="uap_relevant"         string="UAP-relevanta"      domain="[('is_false_positive','=',False)]"/>
        <separator/>
        <filter name="class_confirmed" string="Bekräftad UAP"  domain="[('relevance_class','=','confirmed')]"/>
        <filter name="class_likely"    string="Trolig UAP"     domain="[('relevance_class','=','likely')]"/>
        <filter name="class_offtopic"  string="Ej UAP"         domain="[('relevance_class','=','off_topic')]"/>
        <filter name="class_unclassed" string="Oklassificerad"  domain="[('relevance_class','=','not_classified')]"/>
        <separator/>
        <filter name="not_fetched"  string="Ej hämtad"   domain="[('fetch_status','=','not_fetched')]"/>
        <filter name="fetched"      string="Hämtad"       domain="[('fetch_status','in',['success','partial'])]"/>
        <filter name="paywalled"    string="Betalvägg"    domain="[('fetch_status','=','paywalled')]"/>
        <group>
          <filter name="group_class"        string="Klassificering"    context="{'group_by': 'relevance_class'}"/>
          <filter name="group_source"       string="Källa"              context="{'group_by': 'source'}"/>
          <filter name="group_country"      string="Land"               context="{'group_by': 'country'}"/>
          <filter name="group_tone"         string="Ton"                context="{'group_by': 'tone'}"/>
          <filter name="group_frame"        string="Inramning"          context="{'group_by': 'thematic_frame'}"/>
          <filter name="group_author"       string="Journalist (rå)"    context="{'group_by': 'author'}"/>
          <filter name="group_journalist"    string="Journalist"         context="{'group_by': 'journalist_ids'}"/>
          <filter name="group_protocol"     string="Protokoll"          context="{'group_by': 'protocol_id'}"/>
          <filter name="group_type"         string="Mediatyp"           context="{'group_by': 'media_type'}"/>
          <filter name="group_data_source"  string="Datakälla"          context="{'group_by': 'data_source'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ── Action ─────────────────────────────────────────────────────────── -->
  <record id="action_clio_media_article" model="ir.actions.act_window">
    <field name="name">Artiklar</field>
    <field name="res_model">clio.media.article</field>
    <field name="view_mode">list,kanban,graph,pivot,form</field>
  </record>

  <!-- ── Meny ───────────────────────────────────────────────────────────── -->
  <menuitem id="menu_clio_media_root"
            name="Clio Media"
            sequence="99"/>
  <menuitem id="menu_clio_media_articles"
            name="Artiklar"
            parent="menu_clio_media_root"
            action="action_clio_media_article"/>

</odoo>
