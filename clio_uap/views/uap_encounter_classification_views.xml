<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Listvy (fristående) -->
  <record id="view_uap_encounter_classification_tree" model="ir.ui.view">
    <field name="name">uap.encounter.classification.list</field>
    <field name="model">uap.encounter.classification</field>
    <field name="arch" type="xml">
      <list>
        <field name="encounter_id"/>
        <field name="system"/>
        <field name="class_value"/>
        <field name="label"/>
        <field name="transmorf_entity_id" optional="show"/>
        <field name="confidence"/>
        <field name="source"/>
        <field name="classified_at"/>
      </list>
    </field>
  </record>

  <!-- Formvy (fristående + inbäddad) -->
  <record id="view_uap_encounter_classification_form" model="ir.ui.view">
    <field name="name">uap.encounter.classification.form</field>
    <field name="model">uap.encounter.classification</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="encounter_id"/>
            <field name="system"/>
            <field name="class_value"/>
            <field name="label"/>
            <field name="transmorf_entity_id"
                   invisible="system != 'transmorf_entity'"/>
          </group>
          <group>
            <field name="confidence"/>
            <field name="source"/>
            <field name="classified_at"/>
          </group>
          <group col="1">
            <field name="notes" nolabel="1"
                   placeholder="Motivering: morfologi, beteende, spektralsignatur..."/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Action -->
  <record id="action_uap_encounter_classification" model="ir.actions.act_window">
    <field name="name">Klassificeringar</field>
    <field name="res_model">uap.encounter.classification</field>
    <field name="view_mode">list,form</field>
  </record>

</odoo>
