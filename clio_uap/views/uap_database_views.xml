<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_uap_database_list" model="ir.ui.view">
    <field name="name">uap.database.list</field>
    <field name="model">uap.database</field>
    <field name="arch" type="xml">
      <list string="UAP Databases">
        <field name="name"/>
        <field name="db_type"/>
        <field name="language"/>
        <field name="partner_id"/>
        <field name="encounter_count"/>
      </list>
    </field>
  </record>
  <record id="view_uap_database_form" model="ir.ui.view">
    <field name="name">uap.database.form</field>
    <field name="model">uap.database</field>
    <field name="arch" type="xml">
      <form string="UAP Database">
        <sheet>
          <group>
            <field name="name"/>
            <field name="db_type"/>
            <field name="language"/>
            <field name="partner_id"/>
            <field name="db_url"/>
            <field name="record_count"/>
            <field name="last_synced"/>
          </group>
          <field name="description"/>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_uap_database" model="ir.actions.act_window">
    <field name="name">UAP Databases</field>
    <field name="res_model">uap.database</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
