<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Listvy -->
  <record id="view_uap_report_tree" model="ir.ui.view">
    <field name="name">uap.report.list</field>
    <field name="model">uap.report</field>
    <field name="arch" type="xml">
      <list default_order="report_date desc">
        <field name="external_id" string="ID"/>
        <field name="raw_title"/>
        <field name="report_date" string="Date"/>
        <field name="country_id"/>
        <field name="location_text" string="Location"/>
        <field name="shape"/>
        <field name="skywatcher_class" optional="show"/>
        <field name="database_id" string="Source"/>
        <field name="reporter_type" string="Reporter"/>
        <field name="status" widget="badge"
               decoration-success="status == 'linked'"
               decoration-warning="status == 'unlinked'"
               decoration-muted="status == 'duplicate'"
               decoration-danger="status == 'rejected'"/>
      </list>
    </field>
  </record>

  <!-- Formvy -->
  <record id="view_uap_report_form" model="ir.ui.view">
    <field name="name">uap.report.form</field>
    <field name="model">uap.report</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group string="Status">
            <field name="status"/>
            <field name="encounter_id" invisible="status != 'linked'"/>
          </group>
          <group string="Source">
            <field name="database_id"/>
            <field name="external_id"/>
            <field name="import_batch"/>
          </group>
          <group string="Observation">
            <field name="raw_title"/>
            <field name="report_date"/>
            <field name="country_id"/>
            <field name="location_text"/>
            <field name="geo_lat"/>
            <field name="geo_lng"/>
            <field name="reporter_type"/>
            <field name="shape"/>
            <field name="duration_text"/>
          </group>
          <group string="Skywatcher Classification">
            <field name="skywatcher_class"/>
            <field name="skywatcher_confidence"/>
          </group>
          <group string="Description">
            <field name="raw_description" nolabel="1" colspan="2"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Sokvy -->
  <record id="view_uap_report_search" model="ir.ui.view">
    <field name="name">uap.report.search</field>
    <field name="model">uap.report</field>
    <field name="arch" type="xml">
      <search>
        <field name="raw_title" string="Title"/>
        <field name="external_id" string="External ID"/>
        <field name="country_id"/>
        <field name="database_id" string="Source DB"/>
        <filter string="Unlinked" name="unlinked" domain="[('status','=','unlinked')]"/>
        <filter string="Linked"   name="linked"   domain="[('status','=','linked')]"/>
        <separator/>
        <filter string="SW klassificerad"   name="sw_set"   domain="[('skywatcher_class','!=',False)]"/>
        <filter string="SW ej klassificerad" name="sw_unset" domain="[('skywatcher_class','=',False)]"/>
        <separator/>
        <filter string="GEIPAN"     name="geipan" domain="[('external_id','like','GEIPAN-')]"/>
        <filter string="NUFORC"     name="nuforc" domain="[('external_id','like','nuforc_')]"/>
        <filter string="Wikipedia"  name="wiki"   domain="[('external_id','like','WIKI-')]"/>
        <group>
          <filter string="Country"          name="gb_country"   context="{'group_by':'country_id'}"/>
          <filter string="Source DB"        name="gb_database"  context="{'group_by':'database_id'}"/>
          <filter string="Shape"            name="gb_shape"     context="{'group_by':'shape'}"/>
          <filter string="Skywatcher Class" name="gb_sw"        context="{'group_by':'skywatcher_class'}"/>
          <filter string="Status"           name="gb_status"    context="{'group_by':'status'}"/>
          <filter string="Batch"            name="gb_batch"     context="{'group_by':'import_batch'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Action -->
  <record id="action_uap_report" model="ir.actions.act_window">
    <field name="name">Raw Reports</field>
    <field name="res_model">uap.report</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_uap_report_search"/>
    <field name="context">{'search_default_unlinked': 1}</field>
  </record>

</odoo>
