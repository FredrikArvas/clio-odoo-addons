<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- relevance_class/tone-fälten och deras vy-exponering finns redan i clio_media
       (clio_media_article_views.xml). Det som saknas är själva klassificeringsknappen. -->
  <record id="action_classify_uap" model="ir.actions.server">
    <field name="name">Klassificera UAP-relevans</field>
    <field name="model_id" ref="clio_media.model_clio_media_article"/>
    <field name="binding_model_id" ref="clio_media.model_clio_media_article"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">records.action_classify_uap()</field>
  </record>

  <!-- Smart knapp: vilka encounters bygger på artikeln/dokumentet -->
  <record id="view_clio_media_article_form_uap" model="ir.ui.view">
    <field name="name">clio.media.article.form.uap</field>
    <field name="model">clio.media.article</field>
    <field name="inherit_id" ref="clio_media.view_clio_media_article_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/*[1]" position="before">
        <div class="oe_button_box" name="button_box">
          <button name="action_open_encounters"
                  type="object"
                  class="oe_stat_button"
                  icon="fa-eye"
                  invisible="not encounter_count">
            <field name="encounter_count" widget="statinfo" string="Encounters"/>
          </button>
        </div>
      </xpath>
    </field>
  </record>

</odoo>
