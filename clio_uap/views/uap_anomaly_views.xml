<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Listvy -->
  <record id="view_uap_anomaly_tree" model="ir.ui.view">
    <field name="name">uap.anomaly.list</field>
    <field name="model">uap.anomaly</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="anomaly_type"/>
        <field name="date_first"/>
        <field name="date_last"/>
        <field name="confidence"/>
        <field name="eth_relevance"/>
        <field name="status"/>
        <field name="source_count" string="Källor"/>
        <field name="encounter_count" string="Encounters"/>
      </list>
    </field>
  </record>

  <!-- Formvy -->
  <record id="view_uap_anomaly_form" model="ir.ui.view">
    <field name="name">uap.anomaly.form</field>
    <field name="model">uap.anomaly</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="name" placeholder="Ariel School Zimbabwe 1994"/>
              <field name="anomaly_type"/>
              <field name="status"/>
            </group>
            <group>
              <field name="confidence"/>
              <field name="eth_relevance"/>
            </group>
          </group>

          <group string="Geografi &amp; Tidsperiod">
            <group>
              <field name="location"/>
              <field name="geo_lat"/>
              <field name="geo_lng"/>
              <field name="radius_km"/>
            </group>
            <group>
              <field name="date_first"/>
              <field name="date_last"/>
            </group>
          </group>

          <group col="1">
            <field name="description" nolabel="1"
                   placeholder="Beskriv fenomenet: vad observerades, av vem, under vilka omständigheter..."/>
          </group>

          <notebook>
            <page string="Källor">
              <field name="source_ids" nolabel="1">
                <list editable="bottom">
                  <field name="source_type"/>
                  <field name="source_ref"/>
                  <field name="timestamp_in_source"/>
                  <field name="encounter_id" optional="show"/>
                  <field name="uap_source_id" optional="hide"/>
                  <field name="added_at" optional="hide"/>
                </list>
              </field>
            </page>

            <page string="Transmorf-entiteter">
              <field name="transmorf_entity_ids" nolabel="1">
                <list>
                  <field name="name"/>
                  <field name="category"/>
                  <field name="family_taxon"  string="Familj"/>
                  <field name="genus_taxon"   string="Släkte"/>
                  <field name="species_taxon" string="Art"/>
                  <field name="biological_status"/>
                  <field name="confidence"/>
                </list>
              </field>
            </page>

            <page string="Encounters">
              <field name="encounter_ids" nolabel="1">
                <list>
                  <field name="encounter_id"/>
                  <field name="title_en"/>
                  <field name="date_observed"/>
                  <field name="country_id"/>
                  <field name="encounter_class"/>
                  <field name="eth_origin"/>
                </list>
              </field>
            </page>

            <page string="Anteckningar">
              <group col="1">
                <field name="notes" nolabel="1"
                       placeholder="Övrigt: metodologiska anmärkningar, tvivel, oklarheter..."/>
              </group>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Kanban -->
  <record id="view_uap_anomaly_kanban" model="ir.ui.view">
    <field name="name">uap.anomaly.kanban</field>
    <field name="model">uap.anomaly</field>
    <field name="arch" type="xml">
      <kanban default_group_by="anomaly_type">
        <field name="name"/>
        <field name="anomaly_type"/>
        <field name="confidence"/>
        <field name="eth_relevance"/>
        <field name="status"/>
        <field name="source_count"/>
        <field name="encounter_count"/>
        <templates>
          <t t-name="card">
            <div class="fw-bold">
              <field name="name"/>
            </div>
            <div class="mt-1">
              <span class="badge rounded-pill text-bg-secondary me-1">
                Konf <field name="confidence"/>
              </span>
              <span class="badge rounded-pill text-bg-primary me-1">
                ETH <field name="eth_relevance"/>
              </span>
              <span class="badge rounded-pill text-bg-info me-1">
                <field name="source_count"/> källor
              </span>
              <span class="badge rounded-pill text-bg-warning">
                <field name="encounter_count"/> enc.
              </span>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- Grafvy -->
  <record id="view_uap_anomaly_graph" model="ir.ui.view">
    <field name="name">uap.anomaly.graph</field>
    <field name="model">uap.anomaly</field>
    <field name="arch" type="xml">
      <graph string="Anomalier" type="bar">
        <field name="anomaly_type" type="row"/>
        <field name="confidence" type="col"/>
      </graph>
    </field>
  </record>

  <!-- Pivotvy -->
  <record id="view_uap_anomaly_pivot" model="ir.ui.view">
    <field name="name">uap.anomaly.pivot</field>
    <field name="model">uap.anomaly</field>
    <field name="arch" type="xml">
      <pivot string="Anomalier">
        <field name="anomaly_type" type="row"/>
        <field name="confidence" type="col"/>
      </pivot>
    </field>
  </record>

  <!-- Sökvy -->
  <record id="view_uap_anomaly_search" model="ir.ui.view">
    <field name="name">uap.anomaly.search</field>
    <field name="model">uap.anomaly</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <separator/>
        <filter string="Aktiva" name="active" domain="[('status','=','active')]"/>
        <filter string="Utkast" name="draft" domain="[('status','=','draft')]"/>
        <separator/>
        <filter string="ETH-relevans 3+" name="eth3" domain="[('eth_relevance','in',['3','4','5'])]"/>
        <filter string="Konfidensgrad 3+" name="conf3" domain="[('confidence','in',['3','4','5'])]"/>
        <group>
          <filter string="Typ" name="by_type" context="{'group_by': 'anomaly_type'}"/>
          <filter string="Konfidensgrad" name="by_conf" context="{'group_by': 'confidence'}"/>
          <filter string="ETH-relevans" name="by_eth" context="{'group_by': 'eth_relevance'}"/>
          <filter string="Status" name="by_status" context="{'group_by': 'status'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Action -->
  <record id="action_uap_anomaly" model="ir.actions.act_window">
    <field name="name">Anomalier</field>
    <field name="res_model">uap.anomaly</field>
    <field name="view_mode">list,kanban,graph,pivot,form</field>
    <field name="search_view_id" ref="view_uap_anomaly_search"/>
  </record>

  <!-- Action: encounters från anomali (smart button) -->
  <record id="action_uap_anomaly_encounters" model="ir.actions.act_window">
    <field name="name">Encounters</field>
    <field name="res_model">uap.encounter</field>
    <field name="view_mode">list,form</field>
  </record>

</odoo>
