<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_uap_series_list" model="ir.ui.view">
    <field name="name">uap.series.list</field>
    <field name="model">uap.series</field>
    <field name="arch" type="xml">
      <list string="UAP Series">
        <field name="name"/>
        <field name="series_type"/>
        <field name="date_start"/>
        <field name="date_end"/>
        <field name="encounter_count"/>
        <field name="status"/>
      </list>
    </field>
  </record>
  <record id="view_uap_series_form" model="ir.ui.view">
    <field name="name">uap.series.form</field>
    <field name="model">uap.series</field>
    <field name="arch" type="xml">
      <form string="UAP Series">
        <sheet>
          <group>
            <field name="name"/>
            <field name="series_type"/>
            <field name="status"/>
            <field name="date_start"/>
            <field name="date_end"/>
            <field name="confidence"/>
            <field name="geo_lat"/>
            <field name="geo_lng"/>
            <field name="bbox_km"/>
          </group>
          <field name="notes"/>
          <field name="encounter_ids">
            <list>
              <field name="encounter_id"/>
              <field name="title_en"/>
              <field name="date_observed"/>
              <field name="country_id"/>
            </list>
          </field>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_uap_series" model="ir.actions.act_window">
    <field name="name">UAP Series</field>
    <field name="res_model">uap.series</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
