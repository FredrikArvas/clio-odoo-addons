<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="action_afu_attribute" model="ir.actions.act_window">
    <field name="name">Attributes</field>
    <field name="res_model">afu.attribute</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="action_afu_archive_source" model="ir.actions.act_window">
    <field name="name">Sources</field>
    <field name="res_model">afu.archive.source</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_afu_root"
    name="AFU Archives"
    sequence="100"/>

  <menuitem id="menu_afu_config"
    name="Configuration"
    parent="menu_afu_root"
    sequence="900"/>

  <menuitem id="menu_afu_config_attributes"
    name="Attributes"
    parent="menu_afu_config"
    action="action_afu_attribute"
    sequence="10"/>

  <menuitem id="menu_afu_config_sources"
    name="Sources"
    parent="menu_afu_config"
    action="action_afu_archive_source"
    sequence="20"/>

</odoo>
