<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ── Listvy ─────────────────────────────────────────────────────────── -->
  <record id="view_clio_vigil_item_list" model="ir.ui.view">
    <field name="name">clio.vigil.item.list</field>
    <field name="model">clio.vigil.item</field>
    <field name="arch" type="xml">
      <list string="Bevakningsobjekt"
            decoration-success="state in ('indexed', 'notified', 'captioned')"
            decoration-warning="state in ('queued', 'downloaded', 'transcribing')"
            decoration-info="state == 'transcribed'"
            decoration-muted="state == 'filtered_out'"
            decoration-danger="state == 'crashed'"
            default_order="priority_score desc">
        <field name="priority_score" string="Prio" optional="show"/>
        <field name="published_at"   string="Publicerat" widget="date" optional="show"/>
        <field name="domain"         string="Domän" widget="badge"
               decoration-info="domain == 'ai'"
               decoration-warning="domain == 'ufo'"/>
        <field name="source_name"    string="Källa" optional="show"/>
        <field name="source_maturity" string="Mognad" widget="badge"
               decoration-success="source_maturity == 'akademisk'"
               decoration-info="source_maturity == 'etablerad'"
               decoration-warning="source_maturity == 'tidig'"
               optional="show"/>
        <field name="title"          string="Titel"/>
        <field name="state"          string="Tillstånd" widget="badge"
               decoration-success="state in ('indexed','notified','captioned')"
               decoration-warning="state in ('queued','downloaded','transcribing')"
               decoration-info="state == 'transcribed'"
               decoration-muted="state == 'filtered_out'"
               decoration-danger="state == 'crashed'"/>
        <field name="summary"        string="Sammanfattning" optional="hide"/>
        <button name="action_boost" type="object" icon="fa-bolt"
                string="Boosta" title="Boosta till toppen av kön"
                invisible="state in ('transcribing','transcribed','indexed','notified')"/>
      </list>
    </field>
  </record>

  <!-- ── Formulärvy ─────────────────────────────────────────────────────── -->
  <record id="view_clio_vigil_item_form" model="ir.ui.view">
    <field name="name">clio.vigil.item.form</field>
    <field name="model">clio.vigil.item</field>
    <field name="arch" type="xml">
      <form string="Bevakningsobjekt">
        <header>
          <button name="action_boost"
                  string="⚡ Boosta till kön"
                  type="object"
                  class="btn-primary"
                  invisible="state in ('queued', 'transcribing', 'transcribed', 'indexed', 'notified')"
                  confirm="Boosta detta objekt till toppen av transkriptionskön?"/>
          <button name="action_boost"
                  string="⚡ Boosta (prioritet 999)"
                  type="object"
                  invisible="state not in ('queued', 'filtered_in')"
                  confirm="Sätt prioritet 999 och flytta till toppen av kön?"/>
          <button name="action_reset_to_discovered"
                  string="↩ Återställ"
                  type="object"
                  groups="base.group_system"
                  confirm="Återställ objektet till 'discovered'? Transkription och summering rensas inte automatiskt."/>
          <field name="state" widget="statusbar"
                 statusbar_visible="filtered_in,queued,downloaded,transcribed,indexed,notified"/>
        </header>
        <sheet>
          <group>
            <group string="Objekt">
              <field name="title"       string="Titel"/>
              <field name="url"         string="URL" widget="url"/>
              <field name="published_at" string="Publicerat"/>
              <field name="duration_seconds" string="Längd (s)" optional="hide"/>
            </group>
            <group string="Källa">
              <field name="domain"          string="Domän"/>
              <field name="source_type"     string="Typ"/>
              <field name="source_name"     string="Källa"/>
              <field name="source_maturity" string="Mognad"/>
            </group>
          </group>
          <group>
            <group string="Bearbetning">
              <field name="state"           string="Tillstånd"/>
              <field name="relevance_score" string="Relevansscore"/>
              <field name="priority_score"  string="Prioritet"/>
              <field name="audio_path"      string="Audio-fil" readonly="1"/>
              <field name="created_at"      string="Skapad"    readonly="1"/>
              <field name="notified_at"     string="Notifierad" readonly="1"/>
            </group>
          </group>
          <group string="Sammanfattning">
            <field name="summary" string="" nolabel="1"
                   widget="text" readonly="1"
                   placeholder="(Ingen sammanfattning ännu — körs efter transkription)"/>
          </group>
          <group string="Transkript (utdrag)" invisible="not transcript_snippet">
            <field name="transcript_snippet" string="" nolabel="1"
                   widget="text" readonly="1"/>
          </group>
          <group string="Felmeddelande" invisible="not error_message">
            <field name="error_message" string="" nolabel="1"
                   widget="text" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- ── Sökvy ──────────────────────────────────────────────────────────── -->
  <record id="view_clio_vigil_item_search" model="ir.ui.view">
    <field name="name">clio.vigil.item.search</field>
    <field name="model">clio.vigil.item</field>
    <field name="arch" type="xml">
      <search string="Sök bevakningsobjekt">
        <field name="title"       string="Titel"/>
        <field name="source_name" string="Källa"/>
        <field name="summary"     string="Sammanfattning"/>

        <filter name="in_queue" string="I kö"
                domain="[('state','in',['filtered_in','queued','downloaded','transcribing','transcribed'])]"/>
        <filter name="downloaded" string="Hämtad"
                domain="[('state','=','downloaded')]"/>
        <filter name="ready" string="Klara"
                domain="[('state','in',['indexed','notified'])]"/>
        <filter name="notified" string="Skickade"
                domain="[('state','=','notified')]"/>
        <filter name="filtered_out" string="Filtrerades bort"
                domain="[('state','=','filtered_out')]"/>
        <filter name="crashed" string="Kraschade"
                domain="[('state','=','crashed')]"/>
        <filter name="orphans" string="Saknar mediapost"
                domain="[('has_media_article','=',False)]"/>
        <separator/>
        <filter name="ufo" string="UFO/UAP" domain="[('domain','=','ufo')]"/>
        <filter name="ai"  string="AI"      domain="[('domain','=','ai')]"/>
        <separator/>
        <filter name="etablerad" string="Etablerad+"
                domain="[('source_maturity','in',['etablerad','akademisk'])]"/>
        <filter name="has_summary" string="Har sammanfattning"
                domain="[('summary','!=',False),('summary','!=','')]"/>

        <group>
          <filter name="group_state"       string="Tillstånd"  context="{'group_by': 'state'}"/>
          <filter name="group_domain"      string="Domän"      context="{'group_by': 'domain'}"/>
          <filter name="group_source_type" string="Typ"        context="{'group_by': 'source_type'}"/>
          <filter name="group_source"      string="Källa"      context="{'group_by': 'source_name'}"/>
          <filter name="group_published"   string="Publicerat" context="{'group_by': 'published_at:day'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ── Kanbanvy ──────────────────────────────────────────────────────── -->
  <record id="view_clio_vigil_item_kanban" model="ir.ui.view">
    <field name="name">clio.vigil.item.kanban</field>
    <field name="model">clio.vigil.item</field>
    <field name="arch" type="xml">
      <kanban default_group_by="state" class="o_kanban_small_column">
        <field name="title"/>
        <field name="domain"/>
        <field name="source_name"/>
        <field name="priority_score"/>
        <field name="state"/>
        <field name="published_at"/>
        <field name="summary"/>
        <field name="audio_path"/>
        <templates>
          <t t-name="card">
            <div class="fw-bold fs-6 text-truncate">
              <field name="title"/>
            </div>
            <div class="mt-1">
              <field name="domain" widget="badge"/>
              <span class="text-muted ms-2 small"><field name="source_name"/></span>
            </div>
            <div class="text-muted small mt-1">
              Prio: <field name="priority_score"/>
              &#160;·&#160;<field name="published_at" widget="date"/>
            </div>
            <div t-if="record.audio_path.value" class="text-muted small mt-1 text-truncate">
              🎵 <t t-esc="record.audio_path.value"/>
            </div>
            <div class="mt-2">
              <button name="action_boost" type="object"
                      class="btn btn-sm btn-warning"
                      t-if="!['transcribing','transcribed','indexed','notified'].includes(record.state.raw_value)">
                ⚡ Boosta
              </button>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- ── Diagramvy ──────────────────────────────────────────────────────── -->
  <record id="view_clio_vigil_item_graph" model="ir.ui.view">
    <field name="name">clio.vigil.item.graph</field>
    <field name="model">clio.vigil.item</field>
    <field name="arch" type="xml">
      <graph string="Objekt per tillstånd" type="bar">
        <field name="state"  type="row"/>
        <field name="domain" type="col"/>
      </graph>
    </field>
  </record>

  <!-- ── Admin-vy: rådata i clio.vigil.item för felsökning ─────────────────
       Målet är att alla objekt hanteras via clio.media.article — den här
       vyn visar bara det underliggande pipeline-objektet direkt, för
       felsökning (t.ex. kraschade objekt, indexed_chunks-progress). -->
  <record id="action_clio_vigil_item_debug" model="ir.actions.act_window">
    <field name="name">Felsökning (rådata)</field>
    <field name="res_model">clio.vigil.item</field>
    <field name="view_mode">list,kanban,graph,form</field>
    <field name="context">{'search_default_orphans': 1}</field>
    <field name="search_view_id" ref="view_clio_vigil_item_search"/>
  </record>

</odoo>
