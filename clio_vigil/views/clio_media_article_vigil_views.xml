<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- Formulärutökning: länk till Vigil-pipeline-objekt -->
  <record id="view_clio_media_article_vigil_form" model="ir.ui.view">
    <field name="name">clio.media.article.vigil.form</field>
    <field name="model">clio.media.article</field>
    <field name="inherit_id" ref="clio_media.view_clio_media_article_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="before">
        <header invisible="not vigil_item_id">
          <field name="vigil_state" widget="statusbar"
                 statusbar_visible="queued,downloaded,transcribed,indexed,notified"
                 readonly="1"/>
        </header>
      </xpath>
      <xpath expr="//sheet/group[last()]" position="after">
        <group string="Vigil-pipeline" invisible="not vigil_item_id">
          <field name="vigil_item_id" readonly="1"/>
          <field name="audio_downloaded" widget="boolean_toggle" readonly="1"/>
        </group>
      </xpath>
    </field>
  </record>

  <!-- Listutökning: vigil_item_id och vigil_state-kolumner -->
  <record id="view_clio_media_article_vigil_list" model="ir.ui.view">
    <field name="name">clio.media.article.vigil.list</field>
    <field name="model">clio.media.article</field>
    <field name="inherit_id" ref="clio_media.view_clio_media_article_list"/>
    <field name="arch" type="xml">
      <xpath expr="//list/field[@name='media_type']" position="after">
        <field name="vigil_state" string="Pipeline-status" widget="badge"
               decoration-success="vigil_state in ('indexed','notified','captioned','uap_classified')"
               decoration-warning="vigil_state in ('queued','downloaded','transcribing')"
               decoration-info="vigil_state == 'transcribed'"
               decoration-muted="vigil_state == 'filtered_out'"
               optional="show"/>
        <field name="vigil_notified_at" string="Skickad" optional="hide"/>
        <field name="vigil_item_id" string="Vigil" optional="hide"/>
        <field name="audio_downloaded" string="Nedladdad" widget="boolean" optional="hide"/>
      </xpath>
    </field>
  </record>

  <!-- Sökutökning: group_by vigil_state + vigil_notified_at -->
  <record id="view_clio_media_article_vigil_search" model="ir.ui.view">
    <field name="name">clio.media.article.vigil.search</field>
    <field name="model">clio.media.article</field>
    <field name="inherit_id" ref="clio_media.view_clio_media_article_search"/>
    <field name="arch" type="xml">
      <xpath expr="//search/group" position="inside">
        <filter name="group_vigil_state" string="Pipeline-status"
                context="{'group_by': 'vigil_state'}"/>
        <filter name="group_vigil_notified_at" string="Skickad (datum)"
                context="{'group_by': 'vigil_notified_at:day'}"/>
      </xpath>
    </field>
  </record>

  <!-- ── Actions ─────────────────────────────────────────────────────────── -->

  <!-- Kö: artiklar som bearbetas i vigil-pipelinen -->
  <record id="action_clio_vigil_item_queue" model="ir.actions.act_window">
    <field name="name">Kö</field>
    <field name="res_model">clio.media.article</field>
    <field name="view_mode">list,kanban,graph,pivot,form</field>
    <field name="domain">[('data_source','in',['vigil_ufo','vigil_ai']),('vigil_item_id.state','in',['queued','downloaded','transcribing','transcribed'])]</field>
    <field name="context">{'default_data_source': 'vigil_ufo'}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Kön är tom — inga objekt bearbetas just nu.
      </p>
    </field>
  </record>

  <!-- Klara objekt: indexerade och notifierade -->
  <record id="action_clio_vigil_item_ready" model="ir.actions.act_window">
    <field name="name">Klara objekt</field>
    <field name="res_model">clio.media.article</field>
    <field name="view_mode">list,kanban,graph,pivot,form</field>
    <field name="domain">[('data_source','in',['vigil_ufo','vigil_ai']),('vigil_item_id.state','in',['indexed','notified','uap_classified','captioned'])]</field>
    <field name="context">{'default_data_source': 'vigil_ufo', 'search_default_group_vigil_notified_at': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Inga klara objekt ännu.
      </p>
      <p>
        Objekt hamnar här efter att de indexerats i RAG och
        sammanfattats av Claude.
      </p>
    </field>
  </record>

  <!-- Alla objekt -->
  <record id="action_clio_vigil_media_all" model="ir.actions.act_window">
    <field name="name">Alla objekt</field>
    <field name="res_model">clio.media.article</field>
    <field name="view_mode">list,kanban,graph,pivot,form</field>
    <field name="domain">[('data_source', 'in', ['vigil_ufo', 'vigil_ai'])]</field>
    <field name="context">{'default_data_source': 'vigil_ufo', 'search_default_group_vigil_state': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">Inga bevakningsobjekt ännu.</p>
      <p>Kör <code>python main.py --run</code> för att samla in objekt.</p>
    </field>
  </record>

</odoo>
