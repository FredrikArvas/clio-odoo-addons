<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ── Kanban ─────────────────────────────────────────────────────────── -->

  <record id="view_gsf_jubileum_fastighet_kanban" model="ir.ui.view">
    <field name="name">gsf.jubileum.fastighet.kanban</field>
    <field name="model">gsf.jubileum.fastighet</field>
    <field name="arch" type="xml">
      <kanban default_group_by="status" class="o_kanban_small_column">
        <field name="namn"/>
        <field name="email"/>
        <field name="kanal"/>
        <field name="status"/>
        <field name="datum_inbjudan"/>
        <field name="datum_inlamnad"/>
        <templates>
          <t t-name="card">
            <div class="oe_kanban_global_click">
              <strong><field name="namn"/></strong>
              <div class="text-muted small" t-if="record.email.value">
                <field name="email"/>
              </div>
              <div class="mt-1">
                <field name="kanal" widget="badge"
                       decoration-info="kanal == 'clio_chatt'"
                       decoration-warning="kanal == 'samtal'"
                       decoration-success="kanal == 'skriftligt'"/>
              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- ── List ───────────────────────────────────────────────────────────── -->

  <record id="view_gsf_jubileum_fastighet_list" model="ir.ui.view">
    <field name="name">gsf.jubileum.fastighet.list</field>
    <field name="model">gsf.jubileum.fastighet</field>
    <field name="arch" type="xml">
      <list string="Berättelser"
            decoration-success="status == 'godkand_for_publicering'"
            decoration-info="status == 'inlamnad'"
            decoration-warning="status == 'vantar_godkannande'"
            decoration-muted="status == 'vill_ej_publiceras'">
        <field name="property_id"     string="Fastighet (register)" optional="show"/>
        <field name="namn"            string="Visningsnamn"/>
        <field name="partner_id"      string="Kontakt"   optional="show"/>
        <field name="email"           string="E-post"    optional="show"/>
        <field name="status"          string="Status"    widget="badge"/>
        <field name="kanal"           string="Kanal"     optional="show"/>
        <field name="datum_inbjudan"  string="Inbjuden"  optional="show"/>
        <field name="datum_inlamnad"  string="Inlämnad"  optional="show"/>
      </list>
    </field>
  </record>

  <!-- ── Form ───────────────────────────────────────────────────────────── -->

  <record id="view_gsf_jubileum_fastighet_form" model="ir.ui.view">
    <field name="name">gsf.jubileum.fastighet.form</field>
    <field name="model">gsf.jubileum.fastighet</field>
    <field name="arch" type="xml">
      <form string="Fastighet">
        <header>
          <button name="action_markera_inbjuden" type="object"
                  string="Markera som inbjuden" class="btn-primary"
                  invisible="status != 'ej_kontaktad'"/>
<field name="status" widget="statusbar"
                 statusbar_visible="ej_kontaktad,inbjuden,paborjad,inlamnad,godkand_for_publicering"/>
        </header>
        <sheet>
          <group>
            <group string="Fastighet">
              <field name="property_id" string="Fastighet (register)"
                     options="{'no_create': True, 'no_create_edit': True}"/>
              <field name="namn"        string="Visningsnamn (kan skrivas över)"/>
              <field name="partner_id"  string="Kontaktperson"/>
              <field name="email"       string="E-post"/>
            </group>
            <group string="Status">
              <field name="kanal"          string="Kanal"/>
              <field name="datum_inbjudan" string="Datum inbjudan"/>
              <field name="datum_inlamnad" string="Datum inlämnad"/>
              <field name="chatt_url"      string="Länk (besökare)" widget="url"/>
              <field name="unik_token"     string="Token" optional="show"/>
              <button name="action_generera_token" type="object"
                      string="Generera ny token" class="btn-link"
                      confirm="En ny token ogiltigförklarar den gamla länken. Fortsätt?"/>
            </group>
          </group>

          <notebook>
            <page string="Redaktörens anteckningar" name="anteckningar">
              <field name="anteckningar" nolabel="1" widget="text"
                     style="min-height: 200px; width: 100%;"
                     placeholder="Interna notat — syns ej för familjen."/>
            </page>
            <page string="Svar (11 frågor)" name="svar">
              <field name="svar_ids" nolabel="1">
                <list editable="bottom">
                  <field name="fraga_nr"   string="Nr"    width="50px"/>
                  <field name="fraga_text" string="Fråga" optional="show"/>
                  <field name="svar_text"  string="Svar"  widget="text"/>
                  <field name="kalla"      string="Källa" optional="show"/>
                </list>
              </field>
            </page>
            <page string="Samtycke" name="samtycke">
              <field name="samtycke_ids" nolabel="1">
                <list>
                  <field name="godkand_publicering"    string="Godkänner publicering" widget="boolean_toggle"/>
                  <field name="vill_bli_kontaktad_igen" string="Vill bli kontaktad igen" widget="boolean_toggle"/>
                  <field name="kommentar"               string="Kommentar/villkor"/>
                  <field name="tidsstampel"             string="Tidsstämpel"/>
                </list>
              </field>
            </page>
            <page string="Chatthistorik (rå JSON)" name="chatt" groups="gsf_jubileum.group_admin">
              <field name="coaching_history" nolabel="1" widget="text"
                     style="font-family: monospace; font-size: 11px; min-height: 200px;"/>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>

  <!-- ── Search ─────────────────────────────────────────────────────────── -->

  <record id="view_gsf_jubileum_fastighet_search" model="ir.ui.view">
    <field name="name">gsf.jubileum.fastighet.search</field>
    <field name="model">gsf.jubileum.fastighet</field>
    <field name="arch" type="xml">
      <search string="Sök fastigheter">
        <field name="property_id" string="Fastighet"/>
        <field name="namn" string="Visningsnamn"/>
        <field name="email" string="E-post"/>
        <field name="partner_id" string="Kontaktperson"/>
        <filter name="ej_kontaktad"  string="Ej kontaktad"  domain="[('status','=','ej_kontaktad')]"/>
        <filter name="inbjuden"      string="Inbjuden"      domain="[('status','=','inbjuden')]"/>
        <filter name="paborjad"      string="Påbörjad"      domain="[('status','=','paborjad')]"/>
        <filter name="inlamnad"      string="Inlämnad"      domain="[('status','=','inlamnad')]"/>
        <filter name="godkand"       string="Godkänd"       domain="[('status','=','godkand_for_publicering')]"/>
        <separator/>
        <filter name="kanal_chatt"   string="Clio-chatt"   domain="[('kanal','=','clio_chatt')]"/>
        <filter name="kanal_mejl"    string="Mejl"         domain="[('kanal','=','skriftligt')]"/>
        <filter name="kanal_samtal"  string="Samtal"       domain="[('kanal','=','samtal')]"/>
        <separator/>
        <group>
          <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
          <filter name="group_kanal"  string="Kanal"  context="{'group_by': 'kanal'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- ── Server Actions ───────────────────────────────────────────────── -->

  <record id="action_server_skicka_inbjudan" model="ir.actions.server">
    <field name="name">Skicka inbjudan</field>
    <field name="model_id" ref="gsf_jubileum.model_gsf_jubileum_fastighet"/>
    <field name="binding_model_id" ref="gsf_jubileum.model_gsf_jubileum_fastighet"/>
    <field name="binding_view_types">list</field>
    <field name="state">code</field>
    <field name="code">records.action_skicka_inbjudan()</field>
  </record>

  <!-- ── Action ─────────────────────────────────────────────────────────── -->

  <record id="action_gsf_jubileum_fastigheter" model="ir.actions.act_window">
    <field name="name">Fastigheter</field>
    <field name="res_model">gsf.jubileum.fastighet</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="context">{"search_default_group_status": 1}</field>
  </record>

</odoo>
