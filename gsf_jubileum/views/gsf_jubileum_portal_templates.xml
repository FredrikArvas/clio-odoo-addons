<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ── Intervju-sida (token-baserad, ingen inloggning) ───────────────── -->
  <template id="page_interview" name="GSF Jubileum — Intervju">
    <t t-call="website.layout">
      <t t-set="head">
        <meta name="robots" content="noindex, nofollow"/>
      </t>
      <div class="gsf-interview-root"
           t-att-data-token="token"
           t-att-data-submitted="'true' if inlamnad else 'false'">

        <header class="gsf-header">
          <div class="gsf-header-inner">
            <span class="gsf-logo">GSF</span>
            <span class="gsf-subtitle">Guldboda 80 år — berättelser om era fastigheter</span>
          </div>
        </header>

        <main class="gsf-main">

          <!-- Inlämnad-vy -->
          <t t-if="inlamnad">
            <div class="gsf-submitted-box">
              <h2>Tack!</h2>
              <p>
                Er berättelse om <strong><t t-esc="fastighet.namn"/></strong> är mottagen.
                Fredrik Arvas tar del av den inför jubileumsskriften.
              </p>
              <p class="text-muted small">
                Vill du ändra något eller har frågor? Hör av dig direkt till
                <a href="mailto:fredrik@arvas.se">fredrik@arvas.se</a>.
              </p>
            </div>
          </t>

          <!-- Chatt-vy -->
          <t t-else="">
            <div class="gsf-intro">
              <h1>Välkommen!</h1>
              <p>
                Du är inbjuden att berätta om
                <strong><t t-esc="fastighet.namn"/></strong>
                till Guldboda Samfällighetsförenings 80-årsjubileumsskrift.
              </p>
              <p>
                Clio — vår digitala intervjuare — ställer frågorna en i taget
                och hjälper dig att formulera minnen. Konversationen sparas
                löpande; du kan stänga webbläsaren och komma tillbaka senare
                via samma länk.
              </p>
              <p class="text-muted small">
                Deltagandet är frivilligt. Du granskar och godkänner allt
                material innan det publiceras.
              </p>
            </div>


            <!-- Flodesmätare -->
            <div class="gsf-progress-panel" id="gsf-progress-panel">
              <div class="gsf-progress-header" id="gsf-progress-toggle" role="button" tabindex="0">
                <span class="gsf-progress-title">11 frågeområden · ca 5–15 min</span>
                <div class="gsf-progress-bar-wrap">
                  <div class="gsf-progress-bar" id="gsf-progress-bar" style="width:0%"></div>
                </div>
                <span class="gsf-progress-chevron" id="gsf-progress-chevron">▼</span>
              </div>
              <div class="gsf-progress-list" id="gsf-progress-list" style="display:none;">
                <ol>
                  <li>Öppning — hur familjen hittade hit</li>
                  <li>Ursprung — vem köpte eller byggde</li>
                  <li>Släktträd — generationer och namn</li>
                  <li>Huset och platsen — ombyggnader, tomtens namn</li>
                  <li>Musik — låtar kopplade till somrarna</li>
                  <li>Spel och böcker — sällskapsspel och läsning</li>
                  <li>Lekar och sport — aktiviteter på tomten</li>
                  <li>En anekdot — historien som alltid berättas</li>
                  <li>Ovanliga händelser — oväntade minnen</li>
                  <li>Fritt utrymme — övrigt att ha med</li>
                  <li>Avslutning — samtycke och kontakt</li>
                </ol>
              </div>
            </div>

            <!-- Chattfönster -->
            <div class="gsf-chat-window" id="gsf-chat-window">
              <t t-foreach="history" t-as="msg">
                <div t-attf-class="gsf-bubble gsf-bubble-#{msg['role']}">
                  <span class="gsf-bubble-sender">
                    <t t-if="msg['role'] == 'assistant'">Clio</t>
                    <t t-else="">Du</t>
                  </span>
                  <p><t t-esc="msg['content']"/></p>
                </div>
              </t>
              <div id="gsf-typing" class="gsf-typing" style="display:none;">
                <span>Clio skriver</span><span class="gsf-dots">…</span>
              </div>
            </div>

            <!-- Inmatning -->
            <div class="gsf-input-area">
              <textarea id="gsf-input" class="gsf-textarea"
                        placeholder="Skriv ditt svar här…"
                        rows="4"></textarea>
              <div class="gsf-input-actions">
                <button id="gsf-send-btn" class="gsf-btn gsf-btn-primary">Skicka</button>
                <button id="gsf-submit-btn" class="gsf-btn gsf-btn-secondary"
                        style="display:none;">
                  Skicka in berättelsen →
                </button>
              </div>
            </div>

            <!-- Samtycke / bekräftelsepanel (aktiveras av JS) -->
            <div id="gsf-summary-panel" class="gsf-summary-panel" style="display:none;">
              <h2>Granska och skicka in</h2>
              <p>Kontrollera konversationen ovan och bekräfta sedan:</p>
              <label class="gsf-checkbox-label">
                <input type="checkbox" id="gsf-consent-publish"/>
                Jag godkänner att berättelsen kan publiceras i jubileumsskriften.
              </label>
              <label class="gsf-checkbox-label">
                <input type="checkbox" id="gsf-consent-contact"/>
                Fredrik får kontakta mig igen om han har följdfrågor.
              </label>
              <textarea id="gsf-consent-comment" class="gsf-textarea"
                        placeholder="Ev. villkor (t.ex. 'publicera utan mitt fullständiga namn')"
                        rows="2"></textarea>
              <button id="gsf-confirm-submit-btn" class="gsf-btn gsf-btn-primary">
                Bekräfta och skicka in
              </button>
            </div>
          </t>

        </main>

        <footer class="gsf-footer">
          <p>
            Guldboda Samfällighetsförening ·
            <a href="mailto:fredrik@arvas.se">Kontakta Fredrik</a>
          </p>
        </footer>

      </div>
    </t>
  </template>

  <!-- ── Begär länk ────────────────────────────────────────────────────── -->
  <template id="page_hamta_lank" name="GSF Jubileum — Begär länk">
    <t t-call="website.layout">
      <t t-set="head">
        <meta name="robots" content="noindex, nofollow"/>
      </t>
      <div class="gsf-interview-root">
        <header class="gsf-header">
          <div class="gsf-header-inner">
            <span class="gsf-logo">GSF</span>
            <span class="gsf-subtitle">Guldboda 80 år — berättelser om era fastigheter</span>
          </div>
        </header>
        <main class="gsf-main">
          <div class="gsf-submitted-box">
            <t t-if="sent">
              <h2>Tack!</h2>
              <p>
                Om din e-postadress finns i systemet skickar vi din personliga länk inom kort.
                Kolla gärna skräpposten om du inte ser mailet inom några minuter.
              </p>
              <p class="text-muted small">
                Frågor? Hör av dig till
                <a href="mailto:fredrik@arvas.se">fredrik@arvas.se</a>.
              </p>
            </t>
            <t t-else="">
              <h2>Begär din personliga länk</h2>
              <p>
                Fyll i din e-postadress så skickar vi länken till ditt Clio-samtal.
              </p>
              <form action="/jubileum/hamta-lank" method="post"
                    style="max-width: 400px; margin-top: 1.5rem;">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="mb-3">
                  <label for="email" class="form-label fw-bold">E-postadress</label>
                  <input type="email" name="email" id="email" class="form-control"
                         placeholder="din@epost.se" required="1"/>
                </div>
                <button type="submit" class="btn btn-primary px-4"
                        style="background: #1559ED; border: none; font-weight: 600;">
                  Skicka min länk
                </button>
              </form>
            </t>
          </div>
        </main>
        <footer class="gsf-footer">
          <p>
            Guldboda Samfällighetsförening ·
            <a href="mailto:fredrik@arvas.se">Kontakta Fredrik</a>
          </p>
        </footer>
      </div>
    </t>
  </template>

  <!-- ── Stängd/ogiltig länk ────────────────────────────────────────────── -->
  <template id="page_already_closed" name="GSF Jubileum — Länk inte aktiv">
    <t t-call="website.layout">
      <div class="gsf-interview-root">
        <main class="gsf-main">
          <div class="gsf-submitted-box">
            <h2>Länken är inte längre aktiv</h2>
            <p>
              Om du har frågor — kontakta
              <a href="mailto:fredrik@arvas.se">fredrik@arvas.se</a>.
            </p>
          </div>
        </main>
      </div>
    </t>
  </template>


  <!-- Läsvänlig intervjuvy (för Fredrik som redaktör) -->
  <template id="page_lasvy" name="GSF Jubileum — Läsvy">
    <t t-call="website.layout">
      <div class="gsf-interview-root">
        <header class="gsf-header">
          <div class="gsf-header-inner">
            <span class="gsf-logo">GSF</span>
            <span class="gsf-subtitle">Guldboda 80 år — Intervjusammanfattning</span>
          </div>
        </header>
        <main class="gsf-main">
          <div class="gsf-submitted-box" style="max-width:720px;margin:0 auto;">
            <h2><t t-esc="fastighet.namn"/></h2>
            <p class="text-muted small">
              Inlämnad: <t t-esc="fastighet.datum_inlamnad or '-'"/> ·
              Kanal: <t t-esc="fastighet.kanal or '-'"/>
            </p>
            <t t-if="svar_ids">
              <t t-foreach="svar_ids" t-as="svar">
                <div style="margin-bottom:20px;">
                  <p style="font-weight:600;margin-bottom:4px;">
                    <t t-esc="svar.fraga_nr"/>. <t t-esc="svar.fraga_text"/>
                  </p>
                  <p style="white-space:pre-wrap;margin:0;color:#333;">
                    <t t-if="svar.svar_text">
                      <t t-esc="svar.svar_text"/>
                    </t>
                    <t t-else="">
                      <em style="color:#999;">Inget svar</em>
                    </t>
                  </p>
                </div>
              </t>
            </t>
            <t t-else="">
              <p class="text-muted">Inga svarsposter ännu.</p>
            </t>
            <t t-if="samtycke">
              <hr/>
              <p class="text-muted small">
                Samtycke till publicering:
                <strong><t t-esc="'Ja' if samtycke.godkand_publicering else 'Nej'"/></strong> ·
                Vill bli kontaktad:
                <strong><t t-esc="'Ja' if samtycke.vill_bli_kontaktad_igen else 'Nej'"/></strong>
                <t t-if="samtycke.kommentar">
                  · Kommentar: <em><t t-esc="samtycke.kommentar"/></em>
                </t>
              </p>
            </t>
          </div>
        </main>
      </div>
    </t>
  </template>

</odoo>
