<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- OBS Odoo 19: res.groups har inte längre category_id eller comment -->

  <record id="group_redaktor" model="res.groups">
    <field name="name">GSF Jubileum Redaktör</field>
  </record>

  <record id="group_admin" model="res.groups">
    <field name="name">GSF Jubileum Administratör</field>
    <field name="implied_ids" eval="[(4, ref('group_redaktor'))]"/>
    <field name="users" eval="[(4, ref('base.user_admin'))]"/>
  </record>

</odoo>
