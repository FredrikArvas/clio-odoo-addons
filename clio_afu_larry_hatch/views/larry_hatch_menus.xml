<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="action_afu_larry_hatch_case" model="ir.actions.act_window">
    <field name="name">Larry Hatch Cases</field>
    <field name="res_model">afu.larry_hatch.case</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('is_deleted','=',False)]</field>
  </record>

  <record id="action_afu_larry_hatch_case_all" model="ir.actions.act_window">
    <field name="name">Larry Hatch Cases (inkl. raderade)</field>
    <field name="res_model">afu.larry_hatch.case</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_afu_larry_hatch"
    name="Larry Hatch U*"
    parent="clio_afu_archives.menu_afu_root"
    sequence="10"/>

  <menuitem id="menu_afu_larry_hatch_cases"
    name="Cases"
    parent="menu_afu_larry_hatch"
    action="action_afu_larry_hatch_case"
    sequence="10"/>

  <menuitem id="menu_afu_larry_hatch_cases_all"
    name="Cases (inkl. raderade)"
    parent="menu_afu_larry_hatch"
    action="action_afu_larry_hatch_case_all"
    sequence="20"/>

</odoo>
