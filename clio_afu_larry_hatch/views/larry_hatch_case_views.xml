<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_larry_hatch_case_tree" model="ir.ui.view">
    <field name="name">afu.larry_hatch.case.tree</field>
    <field name="model">afu.larry_hatch.case</field>
    <field name="arch" type="xml">
      <list string="Larry Hatch Cases">
        <field name="year_val"/>
        <field name="date_display" string="Date"/>
        <field name="continent"/>
        <field name="country"/>
        <field name="state_code"/>
        <field name="summary"/>
        <field name="strangeness"/>
        <field name="credibility"/>
        <field name="duration"/>
      </list>
    </field>
  </record>

  <record id="view_larry_hatch_case_form" model="ir.ui.view">
    <field name="name">afu.larry_hatch.case.form</field>
    <field name="model">afu.larry_hatch.case</field>
    <field name="arch" type="xml">
      <form string="Larry Hatch Case">
        <sheet>
          <group>
            <group string="Date &amp; Time">
              <field name="year_val"/>
              <field name="month_val"/>
              <field name="day_val"/>
              <field name="hour_val"/>
              <field name="minute_val"/>
              <field name="duration"/>
            </group>
            <group string="Location">
              <field name="continent"/>
              <field name="country"/>
              <field name="state_code"/>
              <field name="lat_deg"/>
              <field name="lat_dir"/>
              <field name="lon_deg"/>
              <field name="lon_dir"/>
              <field name="prec"/>
            </group>
          </group>
          <group>
            <group string="Assessment">
              <field name="strangeness"/>
              <field name="credibility"/>
              <field name="terrain"/>
            </group>
            <group string="Source">
              <field name="source_id"/>
              <field name="ref_no"/>
              <field name="page_no"/>
              <field name="rnd_index"/>
              <field name="content_hash"/>
              <field name="import_batch"/>
              <field name="is_deleted"/>
            </group>
          </group>
          <group string="Summary">
            <field name="summary" nolabel="1"/>
          </group>
          <group string="Attributes">
            <field name="attribute_ids" nolabel="1" widget="many2many_tags"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_larry_hatch_case_kanban" model="ir.ui.view">
    <field name="name">afu.larry_hatch.case.kanban</field>
    <field name="model">afu.larry_hatch.case</field>
    <field name="arch" type="xml">
      <kanban default_group_by="continent" default_order="year_val desc">
        <field name="strangeness"/>
        <templates>
          <t t-name="card">
            <div class="o_kanban_record_headings">
              <strong class="o_kanban_record_title">
                <field name="date_display"/> · <field name="country"/>
                <t t-if="record.state_code.raw_value"> / <field name="state_code"/></t>
              </strong>
            </div>
            <div class="small mt-1"><field name="summary"/></div>
            <div class="mt-1 small text-muted">
              <span t-attf-class="badge #{record.strangeness.raw_value &gt;= 7 ? 'text-bg-danger' : 'text-bg-secondary'}">
                S <field name="strangeness"/>
              </span>
              <span class="badge text-bg-secondary ms-1">C <field name="credibility"/></span>
              <t t-if="record.duration.raw_value">
                <span class="ms-1"><field name="duration"/> min</span>
              </t>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_larry_hatch_case_graph" model="ir.ui.view">
    <field name="name">afu.larry_hatch.case.graph</field>
    <field name="model">afu.larry_hatch.case</field>
    <field name="arch" type="xml">
      <graph string="Larry Hatch Cases" type="line">
        <field name="year_val" type="row"/>
      </graph>
    </field>
  </record>

  <record id="view_larry_hatch_case_pivot" model="ir.ui.view">
    <field name="name">afu.larry_hatch.case.pivot</field>
    <field name="model">afu.larry_hatch.case</field>
    <field name="arch" type="xml">
      <pivot string="Larry Hatch Cases">
        <field name="continent" type="row"/>
        <field name="strangeness" type="col"/>
      </pivot>
    </field>
  </record>

  <record id="view_larry_hatch_case_search" model="ir.ui.view">
    <field name="name">afu.larry_hatch.case.search</field>
    <field name="model">afu.larry_hatch.case</field>
    <field name="arch" type="xml">
      <search>
        <field name="summary"/>
        <field name="year_val"/>
        <field name="country"/>
        <field name="continent"/>
        <field name="state_code"/>
        <filter name="not_deleted" string="Active" domain="[('is_deleted','=',False)]"/>
        <filter name="high_strangeness" string="S&gt;=7" domain="[('strangeness','&gt;=',7)]"/>
        <separator/>
        <filter name="group_continent" string="Continent" context="{'group_by':'continent'}"/>
        <filter name="group_country" string="Country" context="{'group_by':'country'}"/>
        <filter name="group_year" string="Year" context="{'group_by':'year_val'}"/>
        <filter name="group_strangeness" string="Strangeness" context="{'group_by':'strangeness'}"/>
        <filter name="group_credibility" string="Credibility" context="{'group_by':'credibility'}"/>
      </search>
    </field>
  </record>

</odoo>
